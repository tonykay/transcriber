{
  "entities": [
    {
      "id": "spec-001-output-directory-flag",
      "name": "Output Directory Flag Feature",
      "type": "feature",
      "description": "CLI feature to override default output directory via --output-dir flag",
      "properties": {
        "status": "COMPLETED",
        "workflow_type": "Simple Feature Addition",
        "qa_verdict": "APPROVED"
      }
    },
    {
      "id": "file-transcriber-sh",
      "name": "transcriber.sh",
      "type": "file",
      "description": "Main Bash script for DJI audio processing pipeline",
      "properties": {
        "language": "bash",
        "executable": true
      }
    },
    {
      "id": "cli-option-output-dir",
      "name": "--output-dir / -o",
      "type": "cli_option",
      "description": "CLI flag to specify custom output directory path",
      "properties": {
        "flags": ["--output-dir", "-o"],
        "type": "argument",
        "default": "~/Resources/Transcripts"
      }
    },
    {
      "id": "cli-option-help",
      "name": "--help / -h",
      "type": "cli_option",
      "description": "CLI flag to display usage information",
      "properties": {
        "flags": ["--help", "-h"]
      }
    },
    {
      "id": "var-output-dir-base",
      "name": "OUTPUT_DIR_BASE",
      "type": "variable",
      "description": "Bash variable holding configurable output directory base path",
      "properties": {
        "scope": "global",
        "default": "~/Resources/Transcripts",
        "override": "environment variable or CLI flag"
      }
    },
    {
      "id": "commit-6e8f2cb",
      "name": "Commit 6e8f2cb",
      "type": "commit",
      "description": "Implementation commit for --output-dir option",
      "properties": {
        "message": "auto-claude: subtask-1-1 - Add --output-dir option to transcriber.sh"
      }
    },
    {
      "id": "gotcha-bash-not-python",
      "name": "Bash vs Python Implementation Mismatch",
      "type": "gotcha",
      "description": "Spec referenced Python/Typer CLI but project is actually Bash script",
      "properties": {
        "date": "2026-02-03",
        "context": "subtask-1-1",
        "impact": "Spec needed adaptation from Python to Bash implementation"
      }
    },
    {
      "id": "tool-parakeet-mlx",
      "name": "Parakeet MLX",
      "type": "dependency",
      "description": "Audio-to-text transcription engine optimized for Apple Silicon",
      "properties": {
        "category": "speech-to-text",
        "install": "pip install parakeet-mlx"
      }
    },
    {
      "id": "tool-ollama",
      "name": "Ollama",
      "type": "dependency",
      "description": "AI language model runtime for transcript enhancement",
      "properties": {
        "category": "LLM",
        "url": "https://ollama.com"
      }
    },
    {
      "id": "model-transcriber",
      "name": "transcriber:latest",
      "type": "ollama_model",
      "description": "Custom Ollama model for formatting speech-to-text transcriptions into markdown",
      "properties": {
        "base_model": "Qwen2.5:72b-instruct",
        "purpose": "Handling technical terminology and organizing transcribed content"
      }
    },
    {
      "id": "model-transcriber-reformat",
      "name": "transcriber-reformat",
      "type": "ollama_model",
      "description": "Optional Ollama model for reformatting raw text into structured paragraphs",
      "properties": {
        "base_model": "llama3.3:70b",
        "temperature": 0.1,
        "size": "42 GB",
        "modelfile": "Modelfiles/Modelfile-reformat",
        "preservation": "100% content preservation"
      }
    },
    {
      "id": "script-reformat-transcript",
      "name": "reformat-transcript.sh",
      "type": "helper_script",
      "description": "Helper script for batch processing with transcriber-reformat model",
      "properties": {
        "location": "scripts/reformat-transcript.sh"
      }
    },
    {
      "id": "dir-audio-unprocessed",
      "name": "audio-unprocessed/",
      "type": "directory",
      "description": "Raw audio files from DJI device",
      "properties": {
        "base_path": "~/Resources/Transcripts/audio-unprocessed/",
        "configurable_via": "OUTPUT_DIR_BASE"
      }
    },
    {
      "id": "dir-audio-processed",
      "name": "audio-processed/",
      "type": "directory",
      "description": "Audio files that have been transcribed",
      "properties": {
        "base_path": "~/Resources/Transcripts/audio-processed/",
        "configurable_via": "OUTPUT_DIR_BASE"
      }
    },
    {
      "id": "dir-text-unprocessed",
      "name": "text-unprocessed/",
      "type": "directory",
      "description": "Raw transcription text files from Parakeet MLX",
      "properties": {
        "base_path": "~/Resources/Transcripts/text-unprocessed/",
        "configurable_via": "OUTPUT_DIR_BASE"
      }
    },
    {
      "id": "dir-text-processed",
      "name": "text-processed/",
      "type": "directory",
      "description": "Text files processed by Ollama AI",
      "properties": {
        "base_path": "~/Resources/Transcripts/text-processed/",
        "configurable_via": "OUTPUT_DIR_BASE"
      }
    },
    {
      "id": "dir-transcripts",
      "name": "transcripts/",
      "type": "directory",
      "description": "Final enhanced markdown transcripts",
      "properties": {
        "base_path": "~/Resources/Transcripts/transcripts/",
        "configurable_via": "OUTPUT_DIR_BASE"
      }
    },
    {
      "id": "function-process-dji-audio",
      "name": "process_dji_audio()",
      "type": "function",
      "description": "Import and rename DJI audio files with timestamp parsing",
      "properties": {
        "language": "bash",
        "input_format": "DJI_XX_YYYYMMDD_HHMMSS.WAV",
        "output_format": "YYYY-MM-DD-HH:MM:SS.WAV",
        "source": "/Volumes/DJI_MIC2/DJI_Audio_*/"
      }
    },
    {
      "id": "function-transcribe-audio-files",
      "name": "transcribe_audio_files()",
      "type": "function",
      "description": "Convert audio files to text using Parakeet MLX",
      "properties": {
        "language": "bash",
        "command": "parakeet-mlx $filename --output-format txt --output-dir text-unprocessed"
      }
    },
    {
      "id": "function-process-transcripts",
      "name": "process_transcripts()",
      "type": "function",
      "description": "Enhance transcriptions using Ollama AI language models",
      "properties": {
        "language": "bash",
        "command": "cat $filename | ollama run transcriber:latest | tee $output_file",
        "output_prefix": "transcript-"
      }
    },
    {
      "id": "function-usage",
      "name": "usage()",
      "type": "function",
      "description": "Display comprehensive usage instructions",
      "properties": {
        "language": "bash"
      }
    },
    {
      "id": "device-dji-mic2",
      "name": "DJI Mic 2",
      "type": "hardware",
      "description": "DJI audio recording device",
      "properties": {
        "mount_point": "/Volumes/DJI_MIC2/",
        "directory_pattern": "DJI_Audio_*"
      }
    },
    {
      "id": "naming-convention-dji",
      "name": "DJI Filename Convention",
      "type": "convention",
      "description": "DJI device filename format for audio recordings",
      "properties": {
        "pattern": "DJI_XX_YYYYMMDD_HHMMSS.WAV",
        "regex": "^DJI_[0-9]+_([0-9]{8})_([0-9]{6})\\.WAV$"
      }
    },
    {
      "id": "naming-convention-normalized",
      "name": "Normalized Timestamp Convention",
      "type": "convention",
      "description": "Standardized ISO-like timestamp format for renamed files",
      "properties": {
        "pattern": "YYYY-MM-DD-HH:MM:SS.WAV",
        "example": "2025-07-02-17:54:46.WAV"
      }
    },
    {
      "id": "naming-convention-transcript",
      "name": "Transcript Filename Convention",
      "type": "convention",
      "description": "Final markdown transcript filename format",
      "properties": {
        "pattern": "transcript-YYYY-MM-DD-HH:MM:SS.md",
        "example": "transcript-2025-07-02-17:54:46.md"
      }
    },
    {
