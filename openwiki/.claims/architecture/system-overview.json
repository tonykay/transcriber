    {
      "id": "claim_0b37433c62cb4c779f6debb6aad5d9b5",
      "statement": "The installed `transcriber` console script resolves to the Typer application in `transcriber.cli:app`; its `process` command loads configuration, applies invocation-only overrides for template, dictionaries, classification, and LLM fallback, then constructs and runs `Pipeline` with the optional import skip flag.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L25-L26",
          "version": "repo-lines-v1:sha256:0d4d3370d07a2c134fea078ea69d348b70c7857c7b81b3663caab17479fcd79b:"
        },
        {
