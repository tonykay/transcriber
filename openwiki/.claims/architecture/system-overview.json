          "version": "repo-lines-v1:sha256:8e368c9cd2c6d0bbd4bec29cddffeb2b82d8c6b9203af6e6737acb15493acf18:"
        }
      ]
    },
    {
      "id": "claim_9652e1971482428faee0cc63e5807de7",
      "statement": "`Pipeline.run()` is the normal-workflow orchestrator: it loads dictionaries, then performs optional import, transcription, LLM processing, routing/dispatch, and optional classification in that order, returning counters in `PipelineResult` whose successful-total is the processed count.",
      "evidence": [
        {
          "resource": "repo://src/transcriber/pipeline.py#L33-L110",
          "version": "repo-lines-v1:sha256:a0d952b98e69297fb56149071007933147e188a8b58223ec8caa6af4b6cbe9bc:"
        }
      ]
    },
    {
      "id": "claim_362f11121d784c478dbe514682eeb1f9",
      "statement": "The pipeline uses the filesystem as the stage boundary: it scans staged audio and text directories, routes all Markdown currently in `transcripts/`, and performs routing before the optional sorter, so existing transcripts can be routed even without newly processed inputs.",
      "evidence": [
        {
          "resource": "repo://src/transcriber/pipeline.py#L154-L206",
