    {
      "id": "claim_04fcfc85cafd4c0b8888a1af40d491b3",
      "statement": "`reprocess` resolves a relative output filename below `<base>/transcripts/`, derives raw text by removing a leading `transcript-` from the output stem and adding `.txt`, and searches `text-processed` before `text-unprocessed`; when neither exists it reports the checked locations and exits with status 1 without deleting the output.",
      "evidence": [
        {
          "resource": "repo://src/transcriber/cli.py#L186-L215",
          "version": "repo-lines-v1:sha256:f268f429c4cc95bfa3a61beed73dacb9e7f3b7ef43b729a63313938bf4b62171:"
        },
        {
