        }
      ]
    },
    {
      "id": "claim_c2bc3c2ac7da41319f2eb68764462c5c",
      "statement": "When `reprocess` finds the raw text in `text-processed`, it moves it to `text-unprocessed`, then deletes an existing requested Markdown output before checking whether the LLM provider is available; provider unavailability or an unsuccessful result exits with status 1 and does not restore the deleted output or move raw text back.",
      "evidence": [
        {
          "resource": "repo://src/transcriber/cli.py#L202-L232",
          "version": "repo-lines-v1:sha256:0deacdcba28cb4a9b3114ee2a68ddad24f1e1a564aa204d24be0c91c8f280a3e:"
        }
      ]
